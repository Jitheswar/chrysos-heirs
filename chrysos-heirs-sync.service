[Unit]
Description=Chrysos Heirs: match the Omarchy palette to the current wallpaper
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.config/omarchy/themes/chrysos-heirs/bin/chrysos-heirs-watch
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
